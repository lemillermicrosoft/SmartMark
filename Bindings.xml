    </Binding>
    <Binding name="SMARTMARK_MARK_F4" category="SMARTMARK" default="CTRL-ALT-F4">
        SmartMark_SetMarkF4()
    </Binding>
    <Binding name="SMARTMARK_MARK_F5" category="SMARTMARK" default="CTRL-ALT-F5">
        SmartMark_SetMarkF5()
    </Binding>
    <Binding name="SMARTMARK_MARK_F6" category="SMARTMARK" default="CTRL-ALT-F6">
        SmartMark_SetMarkF6()
    </Binding>
    <Binding name="SMARTMARK_MARK_F7" category="SMARTMARK" default="CTRL-ALT-F7">
        SmartMark_SetMarkF7()
    </Binding>
    <Binding name="SMARTMARK_MARK_F8" category="SMARTMARK" default="CTRL-ALT-F8">
