    </Binding>
    <Binding name="SMARTMARK_MARK_F5" header="SMARTMARK" default="CTRL-ALT-F5">
        SmartMark_SetMarkF5()
    </Binding>
    <Binding name="SMARTMARK_MARK_F6" header="SMARTMARK" default="CTRL-ALT-F6">
        SmartMark_SetMarkF6()
    </Binding>
    <Binding name="SMARTMARK_MARK_F7" header="SMARTMARK" default="CTRL-ALT-F7">
